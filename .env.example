# Copie este arquivo para .env.local e preencha.
# Sem GEMINI_KEY o site roda em MODO DEMONSTRAÇÃO (desenhos de exemplo, sem custo).

# Chave da API do Gemini (https://aistudio.google.com -> Get API key). Nível gratuito, sem cartão.
GEMINI_KEY=

# Modelos (o custo do livro depende disto):
# - o PERSONAGEM é gerado 1 vez por criança: vale usar o modelo melhor.
# - as PÁGINAS são 5 por livro: por padrão usam o modelo mais barato.
# Preços por imagem (nov/2026): gemini-2.5-flash-image ~US$0,04;
# gemini-3.1-flash-image-preview ~US$0,07; gemini-3-pro-image-preview ~US$0,13.
GEMINI_MODEL_CHARACTER=gemini-3-pro-image-preview
GEMINI_MODEL_SCENES=gemini-2.5-flash-image

# Código de acesso. Se preenchido, o site só gera desenhos para quem digitar
# este código. Use SEMPRE que publicar o protótipo, para ninguém gastar seus créditos.
ACCESS_CODE=
