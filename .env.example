# Copie este arquivo para .env.local e preencha.
# Sem FAL_KEY o site roda em MODO DEMONSTRAÇÃO (desenhos de exemplo, sem custo).

# Chave da fal.ai (https://fal.ai -> Dashboard -> API Keys)
FAL_KEY=

# Modelo de edição de imagem. Opções para comparar no teste:
#   fal-ai/gemini-25-flash-image/edit   (padrão)
#   fal-ai/flux-pro/kontext
FAL_MODEL=fal-ai/gemini-25-flash-image/edit

# Código de acesso. Se preenchido, o site só gera desenhos para quem digitar
# este código. Use SEMPRE que publicar o protótipo, para ninguém gastar seus créditos.
ACCESS_CODE=
